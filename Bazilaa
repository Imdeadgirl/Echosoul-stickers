<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EchoSoul Stickers | Aesthetic Digital Sticker Shop</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
    
    <style>
        /* --- CSS VARIABLES & RESET --- */
        :root {
            --bg-dark: #121212;
            --bg-card: #1e1e1e;
            --text-main: #e0e0e0;
            --text-muted: #a0a0a0;
            
            /* Pastel Accents */
            --accent-pink: #ffcbeb;
            --accent-mint: #caffbf;
            --accent-lavender: #a0c4ff;
            --accent-peach: #ffc6ff;
            
            --font-heading: 'Cormorant Garamond', serif;
            --font-body: 'Outfit', sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: var(--font-body);
            line-height: 1.6;
            overflow-x: hidden;
        }

        a { text-decoration: none; color: inherit; }
        ul { list-style: none; }

        /* --- NAVIGATION --- */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 5%;
            position: fixed;
            width: 100%;
            top: 0;
            background: rgba(18, 18, 18, 0.9);
            backdrop-filter: blur(10px);
            z-index: 100;
            border-bottom: 1px solid #333;
        }

        .logo {
            font-family: var(--font-heading);
            font-size: 1.8rem;
            font-weight: 600;
            letter-spacing: 1px;
            background: linear-gradient(45deg, var(--accent-pink), var(--accent-lavender));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
        }

        .nav-links a {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: color 0.3s;
        }

        .nav-links a:hover {
            color: var(--accent-pink);
        }

        /* --- HERO SECTION --- */
        .hero {
            height: 90vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 20px;
            background: radial-gradient(circle at center, #252525 0%, #121212 70%);
        }

        .hero h1 {
            font-family: var(--font-heading);
            font-size: 4rem;
            font-style: italic;
            margin-bottom: 1rem;
            opacity: 0;
            animation: fadeUp 1s ease forwards;
        }

        .hero p {
            font-size: 1.2rem;
            color: var(--text-muted);
           600px;
            margin-bottom:  max-width: 2rem;
            opacity: 0;
            animation: fadeUp 1s ease 0.3s forwards;
        }

        .cta-btn {
            padding: 12px 30px;
            background: transparent;
            border: 1px solid var(--accent-mint);
            color: var(--accent-mint);
            border-radius: 30px;
            font-weight: 600;
            transition: all 0.3s ease;
            cursor: pointer;
            opacity: 0;
            animation: fadeUp 1s ease 0.6s forwards;
        }

        .cta-btn:hover {
            background: var(--accent-mint);
            color: var(--bg-dark);
            box-shadow: 0 0 15px rgba(202, 255, 191, 0.4);
        }

        /* --- SHOP SECTIONS --- */
        .section-container {
            padding: 4rem 5%;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-title {
            font-family: var(--font-heading);
            font-size: 2.5rem;
            margin-bottom: 2rem;
            border-left: 4px solid;
            padding-left: 15px;
            opacity: 0; /* For scroll animation */
            transform: translateY(20px);
            transition: all 0.8s ease;
        }

        /* Dynamic Border Colors per section */
        #funny .section-title { border-color: var(--accent-peach); color: var(--accent-peach); }
        #cool .section-title { border-color: var(--accent-lavender); color: var(--accent-lavender); }
        #study .section-title { border-color: var(--accent-mint); color: var(--accent-mint); }
        #emotional .section-title { border-color: var(--accent-pink); color: var(--accent-pink); }

        /* --- GRID LAYOUT --- */
        .sticker-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
        }

        /* --- PRODUCT CARD --- */
        .sticker-card {
            background: var(--bg-card);
            border-radius: 16px;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid #333;
            display: flex;
            flex-direction: column;
            opacity: 0; /* For scroll animation */
            transform: translateY(30px);
        }

        .sticker-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            border-color: #555;
        }

        .img-container {
            height: 250px;
            background: #2a2a2a;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        /* Simulating Sticker Look with CSS */
        .sticker-mockup {
            width: 180px;
            height: 180px;
            object-fit: cover;
            border-radius: 2% 15% 3% 15%; /* Organic shape */
            box-shadow: 5px 5px 15px rgba(0,0,0,0.3);
            border: 4px solid white;
            transition: transform 0.3s;
        }
        
        .sticker-card:hover .sticker-mockup {
            transform: rotate(-3deg) scale(1.05);
        }

        .card-details {
            padding: 1.5rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .sticker-title {
            font-family: var(--font-heading);
            font-size: 1.4rem;
            margin-bottom: 0.5rem;
        }

        .sticker-price {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        .redbubble-btn {
            display: block;
            width: 100%;
            padding: 10px;
            text-align: center;
            background-color: #fff;
            color: #000;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.85rem;
            transition: background 0.2s;
        }

        .redbubble-btn:hover {
            background-color: #f0f0f0;
        }

        /* --- FOOTER --- */
        footer {
            text-align: center;
            padding: 3rem;
            margin-top: 4rem;
            border-top: 1px solid #333;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* --- ANIMATION UTILS --- */
        @keyframes fadeUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* --- MOBILE RESPONSIVE --- */
        @media (max-width: 768px) {
            .hero h1 { font-size: 2.5rem; }
            .nav-links { display: none; } /* Simplified for this demo */
            .sticker-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
